{
  "name": "set-check-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-cards.js",
    "dev": "vite",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:run": "playwright test --project=default",
    "build": "tsc -b && vite build",
    "generate-cards": "node scripts/generate-card-svgs.js",
    "prebuild": "npm run generate-cards",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "homepage": "http://brianmickel.github.io/set-check"
}
