# Copy to .dev.vars and fill in. Used by `wrangler dev` for local secrets.
# Do not commit .dev.vars.

# Skip rate limits when running locally (avoids 429 during dev)
LOCAL_DEV=true

# Comma-separated IPs that bypass rate limiting in production (e.g. your home IP).
# Set via: npx wrangler secret put ALLOWLISTED_IPS --name set-check-api
# ALLOWLISTED_IPS=1.2.3.4,5.6.7.8

# CORS: empty = localhost:5173 only (dev default). Production value is injected by CI from the ALLOWED_ORIGINS secret.
ALLOWED_ORIGINS=

# Set to false to skip bounding boxes in the analyze prompt and response (cards only)
# INCLUDE_BOUNDING_BOXES=false

# Vision providers — set at least one. Auto-priority: Gemini → Claude → OpenAI.
OPENAI_API_KEY=sk-your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

JWT_SECRET=your-jwt-secret-at-least-32-chars

# Optional: for presigned R2 upload URLs (client PUTs directly to R2)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
