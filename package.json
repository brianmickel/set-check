{
  "name": "set-check",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w set-check-frontend",
    "dev:backend": "npm run dev -w set-check-backend",
    "build:frontend": "npm run build -w set-check-frontend",
    "build:backend": "npm run build -w set-check-backend",
    "lint:frontend": "npm run lint -w set-check-frontend",
    "lint:backend": "npm run lint -w set-check-backend"
  }
}
